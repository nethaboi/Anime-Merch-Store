/* General Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #333;
    line-height: 1.6;
}

.header {
    position: sticky;
    border-bottom: 2px solid #ddd;
}

.top-bar {
    background: #011627;
    color: white;
    padding: 0.5rem;
    text-align: center;
    font-size: 0.9rem;
}

.main-header {
  display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
}

.logo {
    font-size: 1.5rem;
    font-weight: bold;
}

.search-bar {
    display: flex;
    flex-grow: 1;
    margin: 0 2rem;
}

.search-bar input {
    flex-grow: 1;
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 5px 0 0 5px;
}

.search-bar button {
    background: #011627;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0 5px 5px 0;
    cursor: pointer;
}

.header-icons {
    display: flex;
    gap: 1rem;
}

.cart-icon, .profile-icon, .wishlist-icon, .help-icon {
    font-size: 1.5rem;
    cursor: pointer;
}

.nav-menu {
    background: #f8f9fa;
    border-top: 1px solid #ddd;
    padding: 0.5rem 2rem;
    margin: 0;
}

.nav-menu ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    justify-content: center;
}

.nav-menu ul li a {
    text-decoration: none;
    color: #333;
    font-weight: bold;
}

.league-selection {
    padding: 2rem;
    text-align: center;
}

.league-selection h2 {
    margin-bottom: 1rem;
}

.league-icons {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
}

.league {
    text-align: center;
}

.league img {
    width: 70px;
    height: 70px;
    margin-bottom: 0.5rem;
    transition: transform 0.2s ease;
}
.league-icons img:hover {
  transform: scale(1.1); 
}
.sales-banner {
    background: #011627;
    color: white;
    padding: 0;
    margin-top: 1rem;
    position: relative;
    overflow: hidden;
    text-align: center;
}

.sales-banner img {
    width: 100%;
    height: auto;
    display: block;
}

.sales-contents {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 1;
}

.sales-contents h1 {
    font-size: 3rem;
    margin: 0;
    color: white;
    text-align: center;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
}

.video-ad-container {
    position: relative;
    width: 100%; 
    height: 50vh; 
    padding-bottom: 56.25%;
  }
.banner-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
  }
  .banner-sale {
    position: relative;
    overflow: hidden; 
}

.banner-sale img {
    width: 100%; 
}

.sale-content {
    position: absolute; 
    top: 50%; 
    left: 20px; 
    transform: translateY(-50%); 
    color: white; 
    z-index: 1; 
}

.sale-content h2 {
    font-size: 2.5rem; 
    margin-bottom: 10px; 
}

.sale-content p {
    font-size: 1.5rem; 
    margin-bottom: 20px; 
}

.sale-content .btn {
    background-color: #007bff; 
    color: white;
    padding: 10px 20px; 
    font-size: 1.2rem; 
    border: none; 
    border-radius: 5px; 
    text-decoration: none; 
    transition: background-color 0.3s; 
}

.sale-content .btn:hover {
    background-color: #0056b3; 
}
.sales-banner .shop-now-btn {
    background: #011627;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 5px;
    text-decoration: none;
    margin-top: 1rem;
    display: inline-block;
}
.products {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: space-between;
}

.product {
  position: relative;
  width: calc(33.333% - 20px);
  text-align: center;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  padding: 10px;
